# Copy to .env and edit per client VPS
PORT=3000
DATA_DIR=./data/pgdata
UPLOADS_DIR=./uploads
DEFAULT_MOQ=12
ORDER_PREFIX=SH
SHIPPING_FEE=2000
FREE_ABOVE=100000
JWT_SECRET=change-me-to-32-random-chars
# Session cookie name per fork (so two brands on one machine never share logins)
COOKIE_NAME=session
ADMIN_EMAIL=admin@shindara.local
ADMIN_PASSWORD=change-me-too
STORE_NAME=Shindara Fashion World
ORDER_CURRENCY=NGN
PICKUP_ADDRESS=14 Allen Avenue, Ikeja, Lagos
# Optional: real Postgres when past ~50 orders/day (else embedded PGlite)
# DATABASE_URL=postgres://shindara:secret@127.0.0.1:5432/shindara
# Optional: order emails via the vendor's own mailbox (else skipped)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=shop@example.com
# SMTP_PASS=app-password-here
# SMTP_FROM=Shindara Fashion World <shop@example.com>
# Optional: online payments via Bachs (else pay-at-pickup only).
# Sandbox first: sk_sandbox_... at https://sandbox-api.bachs.io (auto-selected).
# Go live = key swap to sk_live_... (base URL follows the key).
# BACHS_SECRET_KEY=sk_sandbox_...
# BACHS_WEBHOOK_SECRET=whsec_...
# PUBLIC_BASE_URL=https://shop.example.com  (where Bachs redirects back to)
# Frontend (Vite) — same origin in prod, so /api works with no CORS
VITE_API_URL=/api
VITE_SITE_NAME=Shindara Fashion World
